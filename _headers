# Netlify headers for Unity WebGL gzip-compressed builds.
#
# Unity (Compression Format = Gzip, Decompression Fallback = OFF) emits
# pre-compressed .gz files. The browser does NOT decompress them itself in this
# mode -- it expects the server to send "Content-Encoding: gzip" so the bytes are
# transparently inflated. Without that header Netlify serves the raw gzip bytes,
# the browser tries to execute them as JS/wasm, and you get a SyntaxError
# ("invalid or unexpected token").
#
# Each rule also sets the *uncompressed* Content-Type (application/wasm,
# application/javascript, application/octet-stream) so WebAssembly streaming
# instantiation works.
#
# Paths are relative to the site root (this repo's contents are published at /).
# Entries for game2/game4 are included up-front so they work the moment those
# games are rebuilt with gzip too -- non-existent files simply never match.

/game2/Build/game2.wasm.gz
  Content-Encoding: gzip
  Content-Type: application/wasm

/game2/Build/game2.framework.js.gz
  Content-Encoding: gzip
  Content-Type: application/javascript

/game2/Build/game2.data.gz
  Content-Encoding: gzip
  Content-Type: application/octet-stream

/game3/Build/game3.wasm.gz
  Content-Encoding: gzip
  Content-Type: application/wasm

/game3/Build/game3.framework.js.gz
  Content-Encoding: gzip
  Content-Type: application/javascript

/game3/Build/game3.data.gz
  Content-Encoding: gzip
  Content-Type: application/octet-stream

/game4/Build/game4.wasm.gz
  Content-Encoding: gzip
  Content-Type: application/wasm

/game4/Build/game4.framework.js.gz
  Content-Encoding: gzip
  Content-Type: application/javascript

/game4/Build/game4.data.gz
  Content-Encoding: gzip
  Content-Type: application/octet-stream
