# Netlify headers for Unity WebGL (Brotli-compressed builds, Decompression Fallback OFF)
#
# Builds are produced with:
#   Compression Format     = Brotli
#   Decompression Fallback = OFF   ->  files are raw Brotli streams named *.br
#
# Because the files are real Brotli streams (NOT Unity's *.unityweb fallback
# container), the browser MUST be told they are br-encoded so it decompresses
# them NATIVELY (off the main thread) and can stream-compile the wasm. This is
# what keeps load times short on mobile (Android Chrome in particular), where
# the old JS main-thread decompression was the bottleneck.
#
# Three artifacts are compressed:
#   *.data.br          -> application/octet-stream
#   *.wasm.br          -> application/wasm
#   *.framework.js.br  -> application/javascript
# The loader (*.loader.js) is plain JS and is left for Netlify to gzip on the fly.
#
# Build files are content-hashed/immutable per build, so cache them aggressively.

/game*/Build/*.data.br
  Content-Encoding: br
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable

/game*/Build/*.wasm.br
  Content-Encoding: br
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

/game*/Build/*.framework.js.br
  Content-Encoding: br
  Content-Type: application/javascript
  Cache-Control: public, max-age=31536000, immutable

# Unity loader is plain JS (not pre-compressed); let Netlify compress it on the fly.
/game*/Build/*.loader.js
  Cache-Control: public, max-age=31536000, immutable
