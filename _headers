# Netlify headers for Unity WebGL (Uncompressed builds)
#
# Builds are produced with:
#   Compression Format = Disabled
#
# No Content-Encoding headers needed — files are raw, Netlify handles
# CDN-level compression automatically for JS/HTML.
#
# The only required header is Content-Type: application/wasm on the .wasm
# file so the browser can use WebAssembly.instantiateStreaming() —
# streaming compilation starts during download instead of after, which
# meaningfully cuts load time on mobile (Android Chrome in particular).
#
# Build files are content-hashed/immutable per build, so cache them aggressively.

/game*/Build/*.data
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable

/game*/Build/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

/game*/Build/*.framework.js
  Content-Type: application/javascript
  Cache-Control: public, max-age=31536000, immutable

# Unity loader — plain JS, let Netlify compress it on the fly.
/game*/Build/*.loader.js
  Cache-Control: public, max-age=31536000, immutable
