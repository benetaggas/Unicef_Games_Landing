# Netlify "_headers" file — drop this INTO the WebGL build output folder
# (the same folder as index.html, next to the /Build subfolder), then upload that
# whole folder to Netlify. Equivalent to netlify.toml; use whichever fits your flow.
#
# Tells Netlify to serve Unity's pre-compressed files with the right Content-Encoding
# so Android Chrome decompresses natively (fast) instead of pulling the raw payload.
# Covers BOTH Brotli (.br) and Gzip (.gz) — only existing files are served.
#
# NOTE: indentation matters in _headers (each header line indented under its path).

# ---------- Brotli (Compression Format = Brotli) ----------
/Build/*.wasm.br
  Content-Encoding: br
  Content-Type: application/wasm
/Build/*.js.br
  Content-Encoding: br
  Content-Type: application/javascript
/Build/*.data.br
  Content-Encoding: br
  Content-Type: application/octet-stream
/Build/*.symbols.json.br
  Content-Encoding: br
  Content-Type: application/octet-stream

# ---------- Gzip (Compression Format = Gzip) ----------
/Build/*.wasm.gz
  Content-Encoding: gzip
  Content-Type: application/wasm
/Build/*.js.gz
  Content-Encoding: gzip
  Content-Type: application/javascript
/Build/*.data.gz
  Content-Encoding: gzip
  Content-Type: application/octet-stream
/Build/*.symbols.json.gz
  Content-Encoding: gzip
  Content-Type: application/octet-stream

# ---------- Long-lived caching for immutable build assets ----------
/Build/*
  Cache-Control: public, max-age=31536000, immutable
